# Frontend API route. Keep same-origin for the integrated Node server.
VITE_LEAD_API_URL=/api/lead

# Kommo account URL, for example https://your-account.kommo.com
KOMMO_BASE_URL=https://YOUR_SUBDOMAIN.kommo.com

# Private integration long-lived token. Set this only on the Node server.
KOMMO_ACCESS_TOKEN=

# Comma-separated exact website origins allowed to submit leads.
ALLOWED_ORIGINS=https://devosoft-landing.devosoft.uz,http://localhost:5173,http://127.0.0.1:5173

# Optional; hosting platforms usually provide PORT.
PORT=3000
